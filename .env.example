# ==============================================================================
# DEV STUDIO — Environment Variables Template (.env.example)
# Copy to .env.local for local development or configure in Vercel Project Settings.
# NEVER commit real API keys, tokens, or SMTP passwords to git.
# ==============================================================================

# Public canonical URL (used for SEO canonical links, Open Graph, sitemap.xml)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. Contact & Booking Email Delivery (Phase 12)
# Primary recipient defaults to kumawatrishi096@gmail.com
# Configure EITHER Resend OR SMTP (or both — Resend is tried first).
# ------------------------------------------------------------------------------
CONTACT_EMAIL=kumawatrishi096@gmail.com
EMAIL_FROM="DEV STUDIO <onboarding@resend.dev>"
SEND_VISITOR_CONFIRMATION=true

# Option A: Resend API (https://resend.com)
RESEND_API_KEY=

# Option B: Standard SMTP (e.g., Gmail App Password, Zoho, SES)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ------------------------------------------------------------------------------
# 2. Google Drive Portfolio Integration (Phase 6)
# Public shared portfolio works out-of-the-box via GOOGLE_DRIVE_ROOT_FOLDER_ID.
# Optional API key / OAuth / Service Account enables higher quota & private files.
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_ROOT_FOLDER_ID=1fIRbUsJen8EHxLfdU5LXlmXJzk_FsztC
GOOGLE_DRIVE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 3. Call Scheduling & WhatsApp (Phase 12)
# Leave NEXT_PUBLIC_CALENDLY_URL empty to use the built-in Asia/Kolkata
# Meeting Request workflow (never displays fake calendar slots).
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=919309425465
NEXT_PUBLIC_CALENDLY_URL=

# ------------------------------------------------------------------------------
# 4. Optional Voiceover Generation (Phase 3.8 — Offline CLI Script Only)
# Used by scripts/generate-elevenlabs-audio.mjs when regenerating studio speech.
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
