  "segments": [
    {
      "id": "intro-01",
      "file": "/audio/intro-01.mp3",
      "text": "Hi, I'm Dev. I'm a video editor, graphic designer, AI generalist, social media manager, and prompt engineer.",
      "start": 0.0,
      "end": 10.296,
      "duration": 10.296,
      "gesture": "welcome"
    },
    {
      "id": "intro-02",
      "file": "/audio/intro-02.mp3",
      "text": "I love transforming ideas into powerful visual experiences.",
      "start": 10.576,
      "end": 15.952,
      "duration": 5.376,
      "gesture": "emphasis"
    },
    {
      "id": "intro-03",
      "file": "/audio/intro-03.mp3",
      "text": "From cinematic video editing and motion graphics to creative branding, photography, and AI-powered content, I bring ideas to life through visual storytelling.",
      "start": 16.232,
      "end": 27.92,
      "duration": 11.688,
      "gesture": "showcase"
    },
    {
      "id": "intro-04",
      "file": "/audio/intro-04.mp3",
      "text": "Take a look around my studio and explore some of my work.",
      "start": 28.2,
      "end": 33.24,
      "duration": 5.04,
      "gesture": "sweep"
    },
    {
      "id": "intro-05",
      "file": "/audio/intro-05.mp3",
      "text": "And when you find something you like, let's create something extraordinary together.",
      "start": 33.52,
      "end": 39.688,
      "duration": 6.168,
      "gesture": "invite"
    }
  ],
